# The throwaway instance for api/test/isolation.js, api/test/security.js and
# frontend/scripts/demo-check.mjs -- the one CI runs. It is docker-compose.yml
# itself, with these values in place of .env (--env-file stops .env being
# read, so no setting of a real instance leaks in):
#
#   docker compose -p bussola-test --env-file api/test/stack.env up -d --build --wait
#   docker compose -p bussola-test --env-file api/test/stack.env down -v
#
# `-p bussola-test` keeps its volume apart. Open sign-up, a 3-second first lock
# so security.js can wait out the doubling, passkeys on at
# http://localhost:3100 so isolation.js runs both ceremonies; no quotes service
# and no model, which is what isolation.js and the demo comparison expect.
BUSSOLA_PORT=3100
PGUSER=bussola
PGPASSWORD=bussola-test
PGDATABASE=bussola
BUSSOLA_AUTH_USER=bussola
BUSSOLA_AUTH_PASS=test-admin-pass
BUSSOLA_SIGNUP=open
BUSSOLA_LOCKOUT_SECONDS=3
BUSSOLA_PUBLIC_URL=http://localhost:3100
SNAPSHOT_CRON=off
BUSSOLA_QUOTES_URL=
