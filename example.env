# Bussola -- copy to `.env` and fill in. Every variable, with its default:
# docs/configuration.md. Apply a change with `docker compose up -d`.

# First account (the instance administrator), created on the first boot only.
BUSSOLA_AUTH_USER=bussola
BUSSOLA_AUTH_PASS=                  # at least 6 characters
#BUSSOLA_DEFAULT_LOCALE=en          # en, it, fr, de, es, zh
#BUSSOLA_SIGNUP=closed              # open: anyone can create an account

# Postgres. Fixed when the database is first created: changing them later does
# not rename anything, it only stops the API from connecting.
PGUSER=bussola
PGPASSWORD=
PGDATABASE=bussola

#BUSSOLA_PORT=3000                  # host port of the app
#BUSSOLA_VERSION=                   # pin the images, e.g. 0.2.0; unset = this compose file's version

# Bank notifications (optional): read by any OpenAI-compatible endpoint, set
# URL and model. A model of your own (e.g. Ollama on another machine) keeps the
# text on your network; a hosted one gets the text of every notification (read
# docs/reading-model.md first).
# Hosted (Groq's free plan; zero data retention: docs/reading-model.md):
#BUSSOLA_AI_URL=https://api.groq.com/openai/v1
#BUSSOLA_AI_MODEL=openai/gpt-oss-20b
#BUSSOLA_AI_API_KEY=gsk_...
# Or your own Ollama (ollama pull qwen3.5:4b; no key). On the host running
# Bussola use host.docker.internal, on another machine its address:
#BUSSOLA_AI_URL=http://host.docker.internal:11434/v1
#BUSSOLA_AI_MODEL=qwen3.5:4b

# Notifications on the phone (Web Push) need only BUSSOLA_PUBLIC_URL below.
# Amount and merchant in the message: off by default.
#BUSSOLA_NOTIFY_DETAILS=on

# Price updates (optional, off by default): COMPOSE_PROFILES=quotes starts the
# quotes container and the refresh buttons come on by themselves. For ETFs and
# stocks add a free key of your own from any of these (docs/price-updates.md):
#COMPOSE_PROFILES=quotes
#EULERPOOL_API_KEY=                 # ETFs and stocks, asked first
#TWELVEDATA_API_KEY=                # ETFs and stocks, asked second
#EODHD_API_KEY=                     # ETFs, ETCs and stocks, asked last (20 calls a day)
#COINGECKO_API_KEY=                 # crypto: a Demo key, steadier rate limit

# Behind HTTPS (see docs/install.md).
#BUSSOLA_PUBLIC_URL=https://bussola.example.com   # turns on passkeys and phone notifications
#BUSSOLA_COOKIE_SECURE=true
#BUSSOLA_TRUSTED_PROXIES=2          # 1 = Bussola's nginx only (default)

# Development with `yarn dev`: the API on this machine, Postgres from
# docker-compose.dev.yml.
#PGHOST=localhost
#PGPORT=5432
